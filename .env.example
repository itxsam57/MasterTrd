MASTERTRD_MODE=PAPER
LIVE_TRADING_ENABLED=false
ORACLE_ENABLED=false

# Persistent runtime inputs. Use an approved StrategyGenome JSON manifest.
# PAPER requires the candidate manifest, session-state path, and exact code identity.
MASTERTRD_CANDIDATE_MANIFEST=
MASTERTRD_SESSION_STATE=
MASTERTRD_CODE_HASH=

# DEMO/TESTNET/LIVE also require the exact Binance product for the candidate:
# SPOT, USD_M, or COIN_M. PAPER does not read this value.
MASTERTRD_BINANCE_PRODUCT=

# Optional deterministic/offline PAPER controls.
MASTERTRD_PUBLIC_FEED_FIXTURE=
MASTERTRD_SESSION_NONCE=
MASTERTRD_PAPER_START_NS=

# Configure real values only in GitHub Secrets or the live host environment.
# Never commit credentials. PAPER/RESEARCH/BACKTEST modes do not read these.
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=
BINANCE_DEMO_ACCOUNT_ID=

BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_TESTNET_ACCOUNT_ID=

BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=
BINANCE_LIVE_ACCOUNT_ID=

MASTERTRD_MODE=PAPER
LIVE_TRADING_ENABLED=false

# Persistent runtime inputs. Use approved provenance-bound manifests only.
# PAPER may use one candidate manifest or a shared portfolio manifest.
MASTERTRD_CANDIDATE_MANIFEST=
MASTERTRD_PORTFOLIO_MANIFEST=
MASTERTRD_SESSION_STATE=
MASTERTRD_CODE_HASH=

# Optional local control-plane paths. Keep them outside git-tracked files.
MASTERTRD_LOCAL_CONFIG=
MASTERTRD_EMERGENCY_STOP=
MASTERTRD_PAPER_ARCHIVE=
MASTERTRD_PAPER_HISTORY_DIR=
MASTERTRD_PAPER_ROTATION_REQUEST=

# DEMO/TESTNET/LIVE also require the exact Binance product for the candidate:
# SPOT, USD_M, or COIN_M. PAPER does not read this value.
MASTERTRD_BINANCE_PRODUCT=

# Optional deterministic/offline PAPER controls.
MASTERTRD_PUBLIC_FEED_FIXTURE=
MASTERTRD_SESSION_NONCE=
MASTERTRD_PAPER_START_NS=

# Configure real values only through the local OS secret store/protected environment.
# Optional CI may use protected GitHub Environment secrets. Never commit credentials.
# PAPER/RESEARCH/BACKTEST modes do not read these.
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=
BINANCE_DEMO_ACCOUNT_ID=

BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_TESTNET_ACCOUNT_ID=

BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=
BINANCE_LIVE_ACCOUNT_ID=

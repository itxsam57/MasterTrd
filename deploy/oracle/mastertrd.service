[Unit]
Description=MasterTrd controlled execution node
Documentation=https://github.com/itxsam57/MasterTrd
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mastertrd
Group=mastertrd
WorkingDirectory=/opt/mastertrd
EnvironmentFile=/etc/mastertrd/mastertrd.env
ExecStart=/opt/mastertrd/.venv/bin/python -m mastertrd.live_node
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/mastertrd /var/lib/mastertrd /var/log/mastertrd
StateDirectory=mastertrd
LogsDirectory=mastertrd
StandardOutput=append:/var/log/mastertrd/mastertrd.log
StandardError=append:/var/log/mastertrd/mastertrd.log

[Install]
WantedBy=multi-user.target
